{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "setup": "node scripts/setup-development.mjs",
    "predev": "npm run projects:sync -- --mode=development",
    "dev": "next dev",
    "prebuild": "npm run env:validate && npm run projects:sync -- --mode=production",
    "build": "next build",
    "start": "next start",
    "env:validate": "node scripts/validate-production-environment.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node tests/run-tests.mjs",
    "test:postgres": "node tests/integration/test-local-postgres.mjs",
    "test:redis": "node tests/integration/test-local-redis.mjs",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-database.mjs migrations",
    "db:verify": "node scripts/check-database.mjs schema",
    "db:seed": "node --import tsx scripts/seed-guestbook.mjs",
    "db:unseed": "node --import tsx scripts/unseed-guestbook.mjs",
    "db:studio": "drizzle-kit studio",
    "projects:sync": "node scripts/sync-github-projects.mjs",
    "calendar:authorize": "node scripts/authorize-google-calendar.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.3.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "cuelume": "^0.2.2",
    "drizzle-orm": "1.0.0-rc.4",
    "googleapis": "^175.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.1",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "redis": "^6.2.1",
    "resend": "^6.20.0",
    "three": "^0.182.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
