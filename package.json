{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:github": "npm run projects:sync && PROJECTS_SOURCE=github next dev",
    "prebuild": "node scripts/sync-github-projects.mjs --if-github",
    "build": "next build",
    "build:github": "PROJECTS_SOURCE=github npm run build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "google-calendar:authorize": "node scripts/authorize-google-calendar.mjs",
    "projects:sync": "node scripts/sync-github-projects.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "googleapis": "^175.0.0",
    "next": "16.3.1",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
