# Required to enable the role-fit assessment at /fit and guestbook moderation.
OPENAI_API_KEY=

# Neon Postgres connection string for the guestbook. In production, set
# this to the Neon pooled connection string. In development, npm run setup
# starts a local Docker Postgres and this defaults to the local service.
DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:5433/portfolio

# Used only outside production by the Docker Redis service.
REDIS_URL=redis://127.0.0.1:6379

# Injected by the Vercel Marketplace Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Must contain at least 32 characters; npm run setup generates a local value.
ANON_SESSION_SECRET=

# GitHub account whose public repositories should be scanned.
GITHUB_OWNER=
# Optional for higher GitHub API rate limits; never required for public repos.
GITHUB_TOKEN=

# Google Calendar OAuth credentials for /api/meetings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional; defaults to the authenticated account's primary calendar.
GOOGLE_CALENDAR_ID=

# Optional best-effort owner notification. Configure all three or leave all unset.
MEETING_OWNER_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
