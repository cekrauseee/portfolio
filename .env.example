# Required to enable the role-fit assessment at /fit.
OPENAI_API_KEY=

# Required in production for anonymous abuse protection (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANON_SESSION_SECRET=

# Public GitHub repositories owned by this account are scanned by default.
GITHUB_OWNER=cekrauseee
# Optional for higher GitHub API rate limits; never required for public repos.
GITHUB_TOKEN=

# Google Calendar OAuth refresh credentials for /api/meetings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Owner notification sent after a calendar event is created.
MEETING_OWNER_NAME=
MEETING_OWNER_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
